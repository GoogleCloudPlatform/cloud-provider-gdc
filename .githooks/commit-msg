set -euo pipefail

COMMIT_MSG_FILE="$1"

# Generate Change-Id if Gerrit hook is present in .git/hooks
GERRIT_HOOK="$(git rev-parse --git-dir)/hooks/commit-msg"
if [ -x "$GERRIT_HOOK" ]; then
  "$GERRIT_HOOK" "$COMMIT_MSG_FILE"
fi

# Validate commit message format via tracked Go tool dependency in go.mod
go run github.com/conventionalcommit/commitlint lint --message "$COMMIT_MSG_FILE"
